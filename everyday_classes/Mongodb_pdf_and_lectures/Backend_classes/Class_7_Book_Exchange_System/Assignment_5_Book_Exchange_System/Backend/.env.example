PORT=5000
MONGO_URI=your_mongodb_connection_string

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Bootstrap admin — the server ensures an account with this email exists
# and always has role "Admin", every time it starts (see config/seedAdmin.js).
# Change these to your own values before deploying anywhere public.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Default number of books a user can list before hitting their limit.
# An admin can override this per-user from the Admin panel (a specific
# number there takes priority over this default; there's no "unlimited"
# override short of setting a very high number).
DEFAULT_BOOK_LIMIT=10

# Used to build the password reset link sent in emails
FRONTEND_URL=http://localhost:5173

# Gmail SMTP for password reset emails. EMAIL_PASS must be a Gmail
# "App Password" (requires 2-Step Verification on the account) —
# generate one at https://myaccount.google.com/apppasswords.
# See Backend/utils/sendEmail.js for full setup steps. If left blank,
# "Forgot password" returns a clear error instead of crashing.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
