# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/attendance_tracker
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendance_tracker?retryWrites=true&w=majority

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Authentication
# Use a long, random, unguessable string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRE=

# Super Admin
# The account with this email is ALWAYS an admin and can NEVER be blocked
# or demoted by anyone through the app (self-healing on every login).
# It is also auto-created on server startup if it doesn't exist yet,
# using the password below — change both before deploying anywhere real.

